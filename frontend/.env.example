# Copia este archivo como .env y ajusta las URLs para tu entorno.
# Reinicia "npm run dev" después de modificarlas.

# Auth Service: API de autenticacion
VITE_AUTH_API_URL=http://localhost:3003

# Order Service: API de pedidos
VITE_ORDER_API_URL=http://localhost:3001

# Delivery Service: API de entregas
VITE_DELIVERY_API_URL=http://localhost:3002

# WebSocket Server: Notificaciones en tiempo real
VITE_WEBSOCKET_URL=http://localhost:4321
