# Copiar a .env (el .env no se sube a Git)
SERVICE_NAME=order-service
PORT=3001

# Ejemplo ficticio local: postgresql://usuario_demo:clave_demo@localhost:5432/delivery_order_db?schema=public
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:PUERTO/delivery_order_db?schema=public"

# Socket Service: dirección TCP interna del servicio que distribuye ofertas.
SOCKET_SERVICE_URL="tcp://localhost:1234"

