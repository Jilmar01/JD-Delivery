SERVICE_NAME=auth-service
PORT=3003

# Base de datos de autenticación.
# Ejemplo ficticio local: postgresql://usuario_demo:clave_demo@localhost:5432/delivery_auth_db?schema=public
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:PUERTO/delivery_auth_db?schema=public"

# Clave usada para firmar los JWT de sesión.
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_UNICO
